# QuickPharma Mobile — copy to .env.local (never commit real values)
#
# Only EXPO_PUBLIC_* variables are embedded in the app bundle.
# NEVER put a backend secret, APP_KEY or Google service-account key here.

# development | staging | production
APP_ENV=production

# Laravel API base URL (must end with /api).
# Android emulator -> host machine: http://10.0.2.2:8000/api
# Physical device on the same Wi-Fi: http://<LAN-IP>:8000/api
# staging / production: HTTPS only.
EXPO_PUBLIC_API_BASE_URL=https://appsassbk.quickpharmaapp.com/api

# HTTP timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=30000

# Translation version served by GET /translations/{lang}/{version}
# (the web app reads version 2 for app texts, version 1 for access.* texts)
EXPO_PUBLIC_TRANSLATION_VERSION=2
EXPO_PUBLIC_ACCESS_TRANSLATION_VERSION=1

# Web app URL (terms, password reset fallback)
EXPO_PUBLIC_WEB_APP_URL=http://localhost:8081

# Google Play package name used to open the subscription management page
EXPO_PUBLIC_ANDROID_PACKAGE=com.quickpharma.mobile
