{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://appsassbk.quickpharmaapp.com/api",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "30000",
        "EXPO_PUBLIC_TRANSLATION_VERSION": "2",
        "EXPO_PUBLIC_ACCESS_TRANSLATION_VERSION": "1",
        "EXPO_PUBLIC_WEB_APP_URL": "https://web.quickpharmaapp.com",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.quickpharma.mobile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
